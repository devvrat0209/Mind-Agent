# JARVIS Agent Configuration
# Copy to .env and fill in. `jarvis setup` writes this file for you.

# ── LLM Provider ───────────────────────────────────────────────
# Pick ONE. NVIDIA NIM is the default and has a generous free tier.

# NVIDIA NIM (hosted) — get a key at https://build.nvidia.com
JARVIS_LLM=nvidia_nim/meta/llama-3.3-70b-instruct
NVIDIA_NIM_API_KEY=nvapi-your-key-here
NVIDIA_NIM_API_BASE=https://integrate.api.nvidia.com/v1
JARVIS_NIM_MODEL=meta/llama-3.3-70b-instruct
JARVIS_NIM_MODE=hosted

# NVIDIA NIM (self-hosted container — needs an NVIDIA GPU)
# JARVIS_NIM_MODE=local
# NVIDIA_NIM_API_BASE=http://localhost:8000/v1

# OpenAI
# JARVIS_LLM=openai/gpt-4o
# OPENAI_API_KEY=sk-your-key-here

# Anthropic
# JARVIS_LLM=anthropic/claude-sonnet-4-20250514
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Ollama (local)
# JARVIS_LLM=ollama/llama3

# Groq
# JARVIS_LLM=groq/llama-3.3-70b-versatile
# GROQ_API_KEY=gsk-your-key-here

# ── Telegram Bot ───────────────────────────────────────────────
# Token from @BotFather
JARVIS_TELEGRAM_TOKEN=your-bot-token-here

# Authorized user IDs (comma-separated, empty = anyone can use the bot).
# Get your ID by messaging @userinfobot
JARVIS_TELEGRAM_USERS=

# ── REST API ───────────────────────────────────────────────────
JARVIS_API_ENABLED=0
JARVIS_API_HOST=127.0.0.1
JARVIS_API_PORT=8088
# Bearer token required on every route except / and /health.
# Leave blank to disable auth (only safe on 127.0.0.1).
JARVIS_API_KEY=
# Comma-separated CORS origins (default *)
# JARVIS_API_CORS=https://example.com

# ── Heartbeat daemon ───────────────────────────────────────────
# Background scheduler that runs alongside the bot/API: status pings,
# health checks, LLM/Telegram connectivity, update checks, log rotation.
# JARVIS_HEARTBEAT_ENABLED=1
# Scheduler resolution in seconds
# JARVIS_HEARTBEAT_TICK=15
# Per-task interval overrides in seconds (0 disables a task):
# JARVIS_HB_STATUS_PING=900
# JARVIS_HB_HEALTH_CHECK=1800
# JARVIS_HB_LLM_CHECK=21600
# JARVIS_HB_TELEGRAM_CHECK=3600
# JARVIS_HB_CHECK_UPDATES=14400
# JARVIS_HB_PRUNE_LOGS=86400
# Autonomous work cycle: every hour the agent works on the standing
# mission in ~/.jarvis/MISSION.md (set it with /mission on Telegram).
# JARVIS_HB_AGENT_WORK=3600
# Max tool calls per autonomous work cycle
# JARVIS_WORK_MAX_CALLS=15
# 1 = send a Telegram report after every work cycle, 0 = journal only
# JARVIS_WORK_REPORT=1

# ── Misc ───────────────────────────────────────────────────────
# Auto-approve self-edits (DANGEROUS)
# JARVIS_AUTO_APPROVE=1
# Where logs go (falls back to ~/.jarvis/logs then /tmp/jarvis)
# JARVIS_LOG_DIR=/var/log/jarvis
