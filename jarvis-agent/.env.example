# JARVIS Agent Configuration

# LLM Provider (uncomment one)
JARVIS_LLM=openai/gpt-4o
OPENAI_API_KEY=sk-your-key-here

# Anthropic
# JARVIS_LLM=anthropic/claude-sonnet-4-20250514
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Ollama (local)
# JARVIS_LLM=ollama/llama3

# Telegram Bot (get token from @BotFather)
JARVIS_TELEGRAM_TOKEN=your-bot-token-here

# Authorized Telegram user IDs (comma-separated, empty = anyone)
# Get your ID by messaging @userinfobot
JARVIS_TELEGRAM_USERS=

# Auto-approve self-edits (DANGEROUS)
# JARVIS_AUTO_APPROVE=1
