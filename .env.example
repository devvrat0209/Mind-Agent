# JARVIS - AI Agent Configuration
# Copy this to .env and fill your keys

# --- LLM Provider ---
# Options: openai, anthropic, google, ollama, openrouter, groq, together, custom
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# For OpenAI / OpenRouter / Groq / Together / Ollama (openai-compatible)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=
# For Anthropic
ANTHROPIC_API_KEY=
# For Google Gemini
GOOGLE_API_KEY=
# For Ollama local (if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3

# --- Agent Config ---
AGENT_NAME=AURA
AGENT_WORKSPACE=./workspace
AGENT_MEMORY_FILE=./memory/memory.jsonl
AGENT_MAX_STEPS=20
AGENT_VERBOSE=true

# --- Tools ---
ENABLE_WEB_SEARCH=true
ENABLE_SHELL=true
ENABLE_FILESYSTEM=true
ENABLE_CODE_EXEC=true
TAVILY_API_KEY=
SERPAPI_KEY=
