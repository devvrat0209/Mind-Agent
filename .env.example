# Copy to .env and `set -a; source .env; set +a` before running the agent.

# --- OpenAI (default) ---
AGENT_API_KEY=sk-...
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=gpt-4o-mini

# --- Any OpenAI-compatible provider ---
# AGENT_BASE_URL=https://openrouter.ai/api/v1
# AGENT_MODEL=anthropic/claude-3.5-sonnet
#
# Local Ollama (no key needed):
# AGENT_BASE_URL=http://localhost:11434/v1
# AGENT_MODEL=qwen2.5-coder:7b
# AGENT_API_KEY=ollama

# --- Behaviour ---
AGENT_MAX_STEPS=12
AGENT_TEMPERATURE=0.2
AGENT_STATE_DIR=.agent_state

# --- Safety switches ---
AGENT_ALLOW_SELF_EDIT=1
AGENT_ALLOW_SHELL=1
AGENT_SHELL_TIMEOUT=60
