# J.A.R.V.I.S. Configuration

# Optional: OpenAI compatible LLM for true AI reasoning
# If not set, JARVIS runs in intelligent rule-based local mode
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Optional custom base URL (for Groq, Together, Ollama, LocalAI etc)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_BASE_URL=http://localhost:11434/v1

# Server
PORT=8000

# Example for Ollama local LLM (free, no API key needed, but needs Ollama running):
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3
# OPENAI_BASE_URL=http://localhost:11434/v1
